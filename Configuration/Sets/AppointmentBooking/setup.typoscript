plugin.tx_appointmentbooking_booking {
    view {
        templateRootPaths.10 = EXT:appointment_booking/Resources/Private/Templates/
    }
}

page {
    includeCSS {
        appointmentBooking = EXT:appointment_booking/Resources/Public/Css/booking.css
    }

    includeJSFooter {
        appointmentBooking = EXT:appointment_booking/Resources/Public/JavaScript/booking.js
        appointmentBooking.defer = 1
    }
}